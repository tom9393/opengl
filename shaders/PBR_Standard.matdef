MaterialDefinition:
  Shader: "GBufferShader"
  TextureBindings:
    Albedo: "pbr.albedoMap"
    Normal: "pbr.normalMap"
    Metallic: "pbr.metallicMap"
    Roughness: "pbr.roughnessMap"
    AO: "pbr.aoMap"
  PropertyBindings:
    AlbedoTint: "pbr.albedoTint"
    Emission: "pbr.emission"
    RoughnessMultiplier: "pbr.roughnessMultiplier"
    MetallicMultiplier: "pbr.metallicMultiplier"